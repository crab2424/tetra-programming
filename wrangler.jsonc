{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citgame",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": ["nodejs_compat"],
  // 本番の独自ドメイン（wrangler deploy で付く。プレビュー版のURLは従来どおり workers.dev のまま）。
  // tetlabo.com のDNSがこのCloudflareアカウントにある（ネームサーバーをCloudflareに向けた）ことが前提
  "routes": [{ "pattern": "tetlabo.com", "custom_domain": true }],
  // routes を書くと workers.dev が既定で無効になるため明示する（プレビュー版のURLと、旧URLのお知らせ画面を残す）
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // これらだけ Worker を先に通す。静的アセットは従来通り Worker を経由しない。
    // "/" と "/index.html" は旧URL（LEGACY_HOST）のときにゲーム画面の代わりにお知らせを返すため（worker/index.ts）
    "run_worker_first": ["/", "/index.html", "/api/*", "/auth/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tetlabo",
      "database_id": "ae8a3300-f49e-413e-a49c-5cbe548dc79c",
      "migrations_dir": "worker/migrations",
    },
    {
      "binding": "DB_DEV",
      "database_name": "tetlabo-dev",
      "database_id": "9c3ff786-130e-4e3b-aa10-bf55f8af7b57",
      "migrations_dir": "worker/migrations",
      // ローカル（wrangler dev）でも Cloudflare 上の開発DBを読み書きする（プレビューURLと同じデータ＝
      // ログイン・設定の同期がそろう）。本番の DB には付けない（localhost から本番データに触れない）
      "remote": true,
    },
  ],
  "vars": {
    "DISCORD_CLIENT_ID": "1549580482486730763",
    // これらのホストへのリクエストだけ本番DB(DB)を使う（カンマ区切り）。それ以外(プレビュー/localhost)は開発DB(DB_DEV)。
    "PROD_HOST": "tetlabo.com",
    // 旧URL。ゲーム画面と /api を外し、お知らせ＋引き継ぎの入口（public/legacy.html）だけ出す（v2.6.1）
    "LEGACY_HOST": "citgame.pptlabo.workers.dev",
    "ADMIN_DISCORD_IDS": "1039886230202110006",
  },
  // Secret（Cloudflareダッシュボードで「Secret」として登録済み・デプロイで消えない）:
  // DISCORD_CLIENT_SECRET, TICKET_PRIVATE_KEY
}
